# Environment Configuration for Forest Tree AMM
# Copy this file to .env and fill in your values

# ⚠️ NEVER commit your .env file to version control!
# ⚠️ Keep your private key secure!

# Your wallet private key (without 0x prefix)
# Get this from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here

# RPC URLs (optional - defaults are provided)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Snowtrace API Key (for contract verification)
# Get your API key from: https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=your_snowtrace_api_key_here

# Token addresses for mainnet deployment
# WAVAX (Wrapped AVAX): 0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7
# USDC: 0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
# USDT.e: 0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7
TOKEN_A_ADDRESS=0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7
TOKEN_B_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# Deployed contract addresses (filled after deployment)
AMM_ADDRESS=
